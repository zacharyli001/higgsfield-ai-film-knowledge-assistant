{
  "manifest_version": 3,
  "name": "Higgsfield AI 影视知识助手",
  "version": "3.10.8",
  "description": "翻译、提炼和迁移 Higgsfield Community 的 AI 影视项目工作流。",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "offscreen",
    "tabCapture",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://higgsfield.ai/*",
    "https://*.higgsfield.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "在当前 Higgsfield 页面启动中文字幕"
  },
  "content_scripts": [
    {
      "matches": [
        "https://higgsfield.ai/*",
        "https://*.higgsfield.ai/*"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
